{
  "name": "jstrace-vscode",
  "displayName": "jstrace",
  "description": "Browse jstrace call logs and jump to the functions they name.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Bohdan Shevchenko",
  "publisher": "local",
  "private": true,
  "type": "commonjs",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [
    "workspaceContains:jstrace.config.json",
    "workspaceContains:.jstrace/logs/*.jsonl"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jstrace",
          "title": "jstrace",
          "icon": "media/jstrace.svg"
        }
      ]
    },
    "views": {
      "jstrace": [
        {
          "id": "jstrace.calls",
          "name": "Calls"
        },
        {
          "id": "jstrace.searchResults",
          "name": "Search",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "jstrace.calls",
        "contents": "No jstrace logs yet.\nTo configure tracing before injecting it, create jstrace.config.json:\n[jstrace: Init](command:jstrace.init)\nThen right-click a folder or file in the Explorer, choose \"jstrace: Inject\", and run your program. Its calls show up here.\n[Refresh](command:jstrace.refresh)"
      },
      {
        "view": "jstrace.searchResults",
        "contents": "Find calls in the logs by function name, file, arguments or value. Double-click a result to show it in the Calls view.\n[Search Calls](command:jstrace.search)"
      }
    ],
    "commands": [
      {
        "command": "jstrace.refresh",
        "title": "Refresh",
        "category": "jstrace",
        "icon": "$(refresh)"
      },
      {
        "command": "jstrace.clearLogs",
        "title": "Clear Logs",
        "category": "jstrace",
        "icon": "$(clear-all)"
      },
      {
        "command": "jstrace.restore",
        "title": "Restore Original Files",
        "category": "jstrace",
        "icon": "$(discard)"
      },
      {
        "command": "jstrace.init",
        "title": "jstrace: Init"
      },
      {
        "command": "jstrace.inject",
        "title": "jstrace: Inject"
      },
      {
        "command": "jstrace.createMock",
        "title": "Create Mock",
        "category": "jstrace"
      },
      {
        "command": "jstrace.mergeLogs",
        "title": "Merge Logs…",
        "category": "jstrace",
        "icon": "$(git-merge)"
      },
      {
        "command": "jstrace.nameProcess",
        "title": "Name Process…",
        "category": "jstrace",
        "icon": "$(tag)"
      },
      {
        "command": "jstrace.openText",
        "title": "Open as Text",
        "category": "jstrace",
        "icon": "$(go-to-file)"
      },
      {
        "command": "jstrace.showDetails",
        "title": "Show Details",
        "category": "jstrace",
        "icon": "$(info)"
      },
      {
        "command": "jstrace.expandAll",
        "title": "Expand All Below",
        "category": "jstrace",
        "icon": "$(expand-all)"
      },
      {
        "command": "jstrace.goToSite",
        "title": "Go to Call Site",
        "category": "jstrace",
        "icon": "$(arrow-right)"
      },
      {
        "command": "jstrace.goToFunction",
        "title": "Go to Function",
        "category": "jstrace",
        "icon": "$(symbol-function)"
      },
      {
        "command": "jstrace.search",
        "title": "Search Calls",
        "category": "jstrace",
        "icon": "$(search)"
      },
      {
        "command": "jstrace.searchLine",
        "title": "jstrace: Find Calls at This Line",
        "icon": "$(search)"
      },
      {
        "command": "jstrace.clearSearch",
        "title": "Clear Search",
        "category": "jstrace",
        "icon": "$(clear-all)"
      },
      {
        "command": "jstrace.showInTree",
        "title": "Show in Calls View",
        "category": "jstrace",
        "icon": "$(list-tree)"
      },
      {
        "command": "jstrace.stepInto",
        "title": "Step Into (Next Call)",
        "category": "jstrace",
        "icon": "$(debug-step-into)"
      },
      {
        "command": "jstrace.stepOver",
        "title": "Step Over (Next Call Here)",
        "category": "jstrace",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "jstrace.stepOut",
        "title": "Step Out (to the Caller)",
        "category": "jstrace",
        "icon": "$(debug-step-out)"
      },
      {
        "command": "jstrace.stepBack",
        "title": "Step Back (Previous Call)",
        "category": "jstrace",
        "icon": "$(debug-step-back)"
      },
      {
        "command": "jstrace.stepBackOver",
        "title": "Step Back Over (Previous Call Here)",
        "category": "jstrace",
        "icon": "$(debug-reverse-continue)"
      },
      {
        "command": "jstrace.hideStep",
        "title": "Hide Step Highlight",
        "category": "jstrace",
        "enablement": "jstrace.stepShown"
      },
      {
        "command": "jstrace.open",
        "title": "Go to Code",
        "category": "jstrace"
      },
      {
        "command": "jstrace.showCall",
        "title": "Show the Call",
        "category": "jstrace"
      },
      {
        "command": "jstrace.openResult",
        "title": "Open Search Result",
        "category": "jstrace"
      },
      {
        "command": "jstrace.showStep",
        "title": "Show Call",
        "category": "jstrace"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "jstrace.search",
          "when": "view == jstrace.calls",
          "group": "navigation@0"
        },
        {
          "command": "jstrace.mergeLogs",
          "when": "view == jstrace.calls",
          "group": "navigation@1"
        },
        {
          "command": "jstrace.refresh",
          "when": "view == jstrace.calls",
          "group": "navigation@2"
        },
        {
          "command": "jstrace.clearLogs",
          "when": "view == jstrace.calls",
          "group": "navigation@3"
        },
        {
          "command": "jstrace.restore",
          "when": "view == jstrace.calls",
          "group": "navigation@4"
        },
        {
          "command": "jstrace.search",
          "when": "view == jstrace.searchResults",
          "group": "navigation@1"
        },
        {
          "command": "jstrace.clearSearch",
          "when": "view == jstrace.searchResults",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "jstrace.showInTree",
          "when": "view == jstrace.searchResults && viewItem =~ /^(call|callSite|external|load)$/",
          "group": "inline@0"
        },
        {
          "command": "jstrace.showInTree",
          "when": "view == jstrace.searchResults && viewItem =~ /^(call|callSite|external|load)$/",
          "group": "0_go@0"
        },
        {
          "command": "jstrace.openText",
          "when": "view == jstrace.calls && viewItem =~ /^(log|mergedLog)$/",
          "group": "inline"
        },
        {
          "command": "jstrace.showDetails",
          "when": "view =~ /^jstrace[.](calls|searchResults)$/ && viewItem =~ /^(call|callSite|external|resume|load|group)$/",
          "group": "inline@2"
        },
        {
          "command": "jstrace.goToFunction",
          "when": "view =~ /^jstrace[.](calls|searchResults)$/ && viewItem =~ /^(call|callSite)$/",
          "group": "inline@1"
        },
        {
          "command": "jstrace.goToSite",
          "when": "view =~ /^jstrace[.](calls|searchResults)$/ && viewItem =~ /^(call|callSite|external|load)$/",
          "group": "inline@3"
        },
        {
          "command": "jstrace.goToSite",
          "when": "view =~ /^jstrace[.](calls|searchResults)$/ && viewItem =~ /^(callSite|external)$/",
          "group": "0_go@1"
        },
        {
          "command": "jstrace.goToFunction",
          "when": "view =~ /^jstrace[.](calls|searchResults)$/ && viewItem =~ /^(call|callSite|resume|group)$/",
          "group": "0_go@2"
        },
        {
          "command": "jstrace.showDetails",
          "when": "view =~ /^jstrace[.](calls|searchResults)$/ && viewItem =~ /^(call|callSite|external|resume|load|group)$/",
          "group": "1_details@1"
        },
        {
          "command": "jstrace.expandAll",
          "when": "view == jstrace.calls && viewItem =~ /^(project|log|mergedLog|call|callSite|external|resume|load|group)$/",
          "group": "1_details@2"
        },
        {
          "command": "jstrace.openText",
          "when": "view == jstrace.calls && viewItem =~ /^(log|mergedLog)$/",
          "group": "1_details@3"
        },
        {
          "command": "jstrace.mergeLogs",
          "when": "view == jstrace.calls && viewItem == log",
          "group": "2_process@1"
        },
        {
          "command": "jstrace.nameProcess",
          "when": "view == jstrace.calls && viewItem == log",
          "group": "2_process@2"
        },
        {
          "submenu": "jstrace.step",
          "when": "view =~ /^jstrace[.](calls|searchResults)$/ && viewItem =~ /^(log|mergedLog|call|callSite|external|resume|load|group)$/",
          "group": "0_go@9"
        }
      ],
      "editor/context": [
        {
          "command": "jstrace.searchLine",
          "when": "resourceScheme == file && editorLangId == javascript",
          "group": "jstrace@1"
        }
      ],
      "explorer/context": [
        {
          "command": "jstrace.init",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "7_modification@8"
        },
        {
          "command": "jstrace.inject",
          "when": "resourceScheme == file",
          "group": "7_modification@9"
        }
      ],
      "commandPalette": [
        {
          "command": "jstrace.searchLine",
          "when": "editorIsOpen && resourceScheme == file"
        },
        {
          "command": "jstrace.openText",
          "when": "false"
        },
        {
          "command": "jstrace.open",
          "when": "false"
        },
        {
          "command": "jstrace.showCall",
          "when": "false"
        },
        {
          "command": "jstrace.openResult",
          "when": "false"
        },
        {
          "command": "jstrace.showStep",
          "when": "false"
        }
      ],
      "jstrace.step": [
        {
          "command": "jstrace.stepInto",
          "group": "1_step@0"
        },
        {
          "command": "jstrace.stepOver",
          "group": "1_step@1"
        },
        {
          "command": "jstrace.stepOut",
          "group": "1_step@2"
        },
        {
          "command": "jstrace.stepBack",
          "group": "2_step@3"
        },
        {
          "command": "jstrace.stepBackOver",
          "group": "2_step@4"
        }
      ]
    },
    "configuration": {
      "title": "jstrace",
      "properties": {
        "jstrace.stepHint": {
          "type": "string",
          "enum": [
            "above",
            "end",
            "hover"
          ],
          "enumDescriptions": [
            "Above the line, as a CodeLens (at the end of the line where CodeLens is off). Click it for the call's details.",
            "At the end of the line.",
            "Only when hovering the line."
          ],
          "default": "above",
          "markdownDescription": "Where a step (or a click on a call) shows the call's arguments and outcome. Hovering the highlighted line shows them in full either way. Their colors are the theme colors `jstrace.stepBackground` and `jstrace.stepForeground` (`workbench.colorCustomizations`)."
        },
        "jstrace.groupRepeats": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "markdownDescription": "When a function is called this many times or more under the same call, its calls are grouped into one row (`add() ×12`), where the first one was. The resumes of an async call are grouped the same way. 0 turns grouping off."
        }
      }
    },
    "colors": [
      {
        "id": "jstrace.stepBackground",
        "description": "The background of the line a jstrace step (or a click on a call) shows.",
        "defaults": {
          "dark": "editor.stackFrameHighlightBackground",
          "light": "editor.stackFrameHighlightBackground",
          "highContrast": "editor.stackFrameHighlightBackground",
          "highContrastLight": "editor.stackFrameHighlightBackground"
        }
      },
      {
        "id": "jstrace.stepForeground",
        "description": "The call's values at the end of the line a jstrace step shows (jstrace.stepHint \"end\").",
        "defaults": {
          "dark": "editorCodeLens.foreground",
          "light": "editorCodeLens.foreground",
          "highContrast": "editorCodeLens.foreground",
          "highContrastLight": "editorCodeLens.foreground"
        }
      }
    ],
    "submenus": [
      {
        "id": "jstrace.step",
        "label": "Step"
      }
    ],
    "keybindings": [
      {
        "command": "jstrace.stepInto",
        "key": "alt+down",
        "when": "focusedView == jstrace.calls"
      },
      {
        "command": "jstrace.stepInto",
        "key": "alt+down",
        "when": "focusedView == jstrace.searchResults",
        "args": "search"
      },
      {
        "command": "jstrace.stepOver",
        "key": "alt+shift+down",
        "when": "focusedView == jstrace.calls"
      },
      {
        "command": "jstrace.stepOver",
        "key": "alt+shift+down",
        "when": "focusedView == jstrace.searchResults",
        "args": "search"
      },
      {
        "command": "jstrace.stepOut",
        "key": "alt+left",
        "when": "focusedView == jstrace.calls"
      },
      {
        "command": "jstrace.stepOut",
        "key": "alt+left",
        "when": "focusedView == jstrace.searchResults",
        "args": "search"
      },
      {
        "command": "jstrace.stepBack",
        "key": "alt+up",
        "when": "focusedView == jstrace.calls"
      },
      {
        "command": "jstrace.stepBack",
        "key": "alt+up",
        "when": "focusedView == jstrace.searchResults",
        "args": "search"
      },
      {
        "command": "jstrace.stepBackOver",
        "key": "alt+shift+up",
        "when": "focusedView == jstrace.calls"
      },
      {
        "command": "jstrace.stepBackOver",
        "key": "alt+shift+up",
        "when": "focusedView == jstrace.searchResults",
        "args": "search"
      },
      {
        "command": "jstrace.hideStep",
        "key": "escape",
        "when": "jstrace.stepShown && (focusedView == jstrace.calls || focusedView == jstrace.searchResults)"
      },
      {
        "command": "jstrace.hideStep",
        "key": "escape",
        "when": "jstrace.stepShown && editorTextFocus && !editorHasSelection && !editorHasMultipleSelections && !findWidgetVisible && !suggestWidgetVisible && !parameterHintsVisible && !inlineSuggestionVisible && !inSnippetMode && !renameInputVisible && !referenceSearchVisible && !markersNavigationVisible && !notificationToastsVisible && vim.mode != 'Insert'"
      }
    ]
  }
}
