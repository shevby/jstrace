{
  "name": "jstrace-vscode",
  "displayName": "jstrace",
  "description": "Browse jstrace call logs and jump to the functions they name.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Bohdan Shevchenko",
  "publisher": "local",
  "private": true,
  "type": "commonjs",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "workspaceContains:jstrace.config.json",
    "workspaceContains:.jstrace/logs/*.jsonl"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jstrace",
          "title": "jstrace",
          "icon": "media/jstrace.svg"
        }
      ]
    },
    "views": {
      "jstrace": [
        {
          "id": "jstrace.calls",
          "name": "Calls"
        },
        {
          "id": "jstrace.searchResults",
          "name": "Search",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "jstrace.calls",
        "contents": "No jstrace logs yet.\nRight-click a folder or file in the Explorer and choose \"Inject jstrace\", then run your program. Its calls show up here.\n[Refresh](command:jstrace.refresh)"
      },
      {
        "view": "jstrace.searchResults",
        "contents": "Find calls in the logs by function name, file, arguments or value. Double-click a result to show it in the Calls view.\n[Search Calls](command:jstrace.search)"
      }
    ],
    "commands": [
      {
        "command": "jstrace.refresh",
        "title": "Refresh",
        "category": "jstrace",
        "icon": "$(refresh)"
      },
      {
        "command": "jstrace.clearLogs",
        "title": "Clear Logs",
        "category": "jstrace",
        "icon": "$(clear-all)"
      },
      {
        "command": "jstrace.restore",
        "title": "Restore Original Files",
        "category": "jstrace",
        "icon": "$(discard)"
      },
      {
        "command": "jstrace.inject",
        "title": "Inject jstrace",
        "category": "jstrace"
      },
      {
        "command": "jstrace.openText",
        "title": "Open as Text",
        "category": "jstrace",
        "icon": "$(go-to-file)"
      },
      {
        "command": "jstrace.showDetails",
        "title": "Show Details",
        "category": "jstrace",
        "icon": "$(info)"
      },
      {
        "command": "jstrace.expandAll",
        "title": "Expand All Below",
        "category": "jstrace",
        "icon": "$(expand-all)"
      },
      {
        "command": "jstrace.goToSite",
        "title": "Go to Call Site",
        "category": "jstrace",
        "icon": "$(call-incoming)"
      },
      {
        "command": "jstrace.goToFunction",
        "title": "Go to Function",
        "category": "jstrace",
        "icon": "$(symbol-function)"
      },
      {
        "command": "jstrace.search",
        "title": "Search Calls",
        "category": "jstrace",
        "icon": "$(search)"
      },
      {
        "command": "jstrace.clearSearch",
        "title": "Clear Search",
        "category": "jstrace",
        "icon": "$(clear-all)"
      },
      {
        "command": "jstrace.showInTree",
        "title": "Show in Calls View",
        "category": "jstrace",
        "icon": "$(list-tree)"
      },
      {
        "command": "jstrace.stepInto",
        "title": "Step Into (Next Call)",
        "category": "jstrace",
        "icon": "$(debug-step-into)"
      },
      {
        "command": "jstrace.stepOver",
        "title": "Step Over (Next Call Here)",
        "category": "jstrace",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "jstrace.stepOut",
        "title": "Step Out (to the Caller)",
        "category": "jstrace",
        "icon": "$(debug-step-out)"
      },
      {
        "command": "jstrace.stepBack",
        "title": "Step Back (Previous Call)",
        "category": "jstrace",
        "icon": "$(debug-step-back)"
      },
      {
        "command": "jstrace.stepBackOver",
        "title": "Step Back Over (Previous Call Here)",
        "category": "jstrace",
        "icon": "$(debug-reverse-continue)"
      },
      {
        "command": "jstrace.open",
        "title": "Go to Code",
        "category": "jstrace"
      },
      {
        "command": "jstrace.showCall",
        "title": "Show the Call",
        "category": "jstrace"
      },
      {
        "command": "jstrace.openResult",
        "title": "Open Search Result",
        "category": "jstrace"
      },
      {
        "command": "jstrace.showStep",
        "title": "Show Call",
        "category": "jstrace"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "jstrace.search",
          "when": "view == jstrace.calls",
          "group": "navigation@0"
        },
        {
          "command": "jstrace.refresh",
          "when": "view == jstrace.calls",
          "group": "navigation@1"
        },
        {
          "command": "jstrace.clearLogs",
          "when": "view == jstrace.calls",
          "group": "navigation@2"
        },
        {
          "command": "jstrace.restore",
          "when": "view == jstrace.calls",
          "group": "navigation@3"
        },
        {
          "command": "jstrace.search",
          "when": "view == jstrace.searchResults",
          "group": "navigation@1"
        },
        {
          "command": "jstrace.clearSearch",
          "when": "view == jstrace.searchResults",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "jstrace.showInTree",
          "when": "view == jstrace.searchResults && viewItem =~ /^(call|callSite|load)$/",
          "group": "inline"
        },
        {
          "command": "jstrace.showInTree",
          "when": "view == jstrace.searchResults && viewItem =~ /^(call|callSite|load)$/",
          "group": "0_go@0"
        },
        {
          "command": "jstrace.openText",
          "when": "view == jstrace.calls && viewItem == log",
          "group": "inline"
        },
        {
          "command": "jstrace.showDetails",
          "when": "view =~ /^jstrace[.](calls|searchResults)$/ && viewItem =~ /^(call|callSite|resume|load|group)$/",
          "group": "inline"
        },
        {
          "command": "jstrace.goToFunction",
          "when": "view =~ /^jstrace[.](calls|searchResults)$/ && viewItem =~ /^(call|callSite)$/",
          "group": "inline"
        },
        {
          "command": "jstrace.goToSite",
          "when": "view =~ /^jstrace[.](calls|searchResults)$/ && viewItem == callSite",
          "group": "0_go@1"
        },
        {
          "command": "jstrace.goToFunction",
          "when": "view =~ /^jstrace[.](calls|searchResults)$/ && viewItem =~ /^(call|callSite|resume|group)$/",
          "group": "0_go@2"
        },
        {
          "command": "jstrace.showDetails",
          "when": "view =~ /^jstrace[.](calls|searchResults)$/ && viewItem =~ /^(call|callSite|resume|load|group)$/",
          "group": "1_details@1"
        },
        {
          "command": "jstrace.expandAll",
          "when": "view == jstrace.calls && viewItem =~ /^(project|log|call|callSite|resume|load|group)$/",
          "group": "1_details@2"
        },
        {
          "command": "jstrace.openText",
          "when": "view == jstrace.calls && viewItem == log",
          "group": "1_details@3"
        },
        {
          "submenu": "jstrace.step",
          "when": "view =~ /^jstrace[.](calls|searchResults)$/ && viewItem =~ /^(log|call|callSite|resume|load|group)$/",
          "group": "0_go@9"
        }
      ],
      "explorer/context": [
        {
          "command": "jstrace.inject",
          "when": "resourceScheme == file",
          "group": "7_modification@9"
        }
      ],
      "commandPalette": [
        {
          "command": "jstrace.openText",
          "when": "false"
        },
        {
          "command": "jstrace.open",
          "when": "false"
        },
        {
          "command": "jstrace.showCall",
          "when": "false"
        },
        {
          "command": "jstrace.openResult",
          "when": "false"
        },
        {
          "command": "jstrace.showStep",
          "when": "false"
        }
      ],
      "jstrace.step": [
        {
          "command": "jstrace.stepInto",
          "group": "1_step@0"
        },
        {
          "command": "jstrace.stepOver",
          "group": "1_step@1"
        },
        {
          "command": "jstrace.stepOut",
          "group": "1_step@2"
        },
        {
          "command": "jstrace.stepBack",
          "group": "2_step@3"
        },
        {
          "command": "jstrace.stepBackOver",
          "group": "2_step@4"
        }
      ]
    },
    "configuration": {
      "title": "jstrace",
      "properties": {
        "jstrace.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The `jstrace` CLI: a `.js` script (run with VSCode's own Node) or a program such as `jstrace` on the PATH. A relative path is taken from the workspace folder. Empty uses the CLI packed in the extension (or the `cli/` beside it in the jstrace repo), or else `jstrace` on the PATH."
        },
        "jstrace.groupRepeats": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "markdownDescription": "When a function is called this many times or more under the same call, its calls are grouped into one row (`add() ×12`), where the first one was. The resumes of an async call are grouped the same way. 0 turns grouping off."
        }
      }
    },
    "submenus": [
      {
        "id": "jstrace.step",
        "label": "Step"
      }
    ],
    "keybindings": [
      {
        "command": "jstrace.stepInto",
        "key": "alt+down",
        "when": "focusedView == jstrace.calls"
      },
      {
        "command": "jstrace.stepInto",
        "key": "alt+down",
        "when": "focusedView == jstrace.searchResults",
        "args": "search"
      },
      {
        "command": "jstrace.stepOver",
        "key": "alt+shift+down",
        "when": "focusedView == jstrace.calls"
      },
      {
        "command": "jstrace.stepOver",
        "key": "alt+shift+down",
        "when": "focusedView == jstrace.searchResults",
        "args": "search"
      },
      {
        "command": "jstrace.stepOut",
        "key": "alt+left",
        "when": "focusedView == jstrace.calls"
      },
      {
        "command": "jstrace.stepOut",
        "key": "alt+left",
        "when": "focusedView == jstrace.searchResults",
        "args": "search"
      },
      {
        "command": "jstrace.stepBack",
        "key": "alt+up",
        "when": "focusedView == jstrace.calls"
      },
      {
        "command": "jstrace.stepBack",
        "key": "alt+up",
        "when": "focusedView == jstrace.searchResults",
        "args": "search"
      },
      {
        "command": "jstrace.stepBackOver",
        "key": "alt+shift+up",
        "when": "focusedView == jstrace.calls"
      },
      {
        "command": "jstrace.stepBackOver",
        "key": "alt+shift+up",
        "when": "focusedView == jstrace.searchResults",
        "args": "search"
      }
    ]
  }
}
