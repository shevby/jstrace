{
  "name": "jstrace-workspace",
  "version": "0.1.0",
  "description": "Traces function calls in CommonJS code; a CLI instrumenter and a VSCode extension to browse the logs.",
  "license": "MIT",
  "author": "Bohdan Shevchenko",
  "private": true,
  "workspaces": [
    "cli",
    "vscode"
  ],
  "scripts": {
    "test": "node --test \"cli/**/*.test.js\" \"vscode/**/*.test.js\" \"test/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "~1.100.0",
    "typescript": "^7.0.2"
  }
}
